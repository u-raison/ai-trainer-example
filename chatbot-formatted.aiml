<!--表示知识库文件的语言是中文-->
<meta name="language" content="zh"/>

<!-- 在此处请根据要求完成机器人对话配置 -->
<!--每组问答的开始标签-->

<!--普通回答-->
<category>
    <pattern>请问在哪里可以接种疫苗</pattern>
    <template>门诊大厅三层北区</template>
</category>

<!--普通回答-->
<category>
    <pattern>你是谁</pattern>
    <template>我是您的智能客服机器人，您要问我什么问题呢？</template>
</category>

<!--随机回答-->
<category>
    <pattern>你好</pattern>
    <template>
        <random>
            <li>你好呀。</li>
            <li>什么事呀？</li>
        </random>
    </template>
</category>

<!--随机回答-->
<category>
    <pattern>再见</pattern>
    <template>
        <!--随机选择一个回答-->
        <random>
            <li>再见,<get name="name"/>.</li>
            <li>好的，有空再聊，<get name="name"/>.</li>
            <li>下次见, <get name="name"/>.</li>
            <li>谢谢你陪我聊天, <get name="name"/>.</li>
            <li>改天见, <get name="name"/>.</li>
        </random>
    </template>
</category>

<!--随机回答-->
<category>
    <pattern>谢谢</pattern>
    <template>
        <random>
            <li>不用谢啦。</li>
            <li>您太客气了。</li>
        </random>
    </template>
</category>

<!--随机回答-->
<category>
    <pattern>HELLO</pattern>
    <template>
        <random>
            <li>你可算来了!哈哈</li>
            <li>你也好啊.</li>
            <li>别来无恙啊？</li>
        </random>
    </template>
</category>

<!--通配符匹配-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*笨*</pattern>
    <template>很抱歉让您失望了。我会加油学习，天天向上的。</template>
</category>

<!--通配符匹配-->
<category>
    <pattern>*傻*</pattern>
    <template>对不起。我还不够聪明，但我不会不断努力的。</template>
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*好棒*</pattern>
    <!--机器人回复-->
    <template>谢谢。其实我还有很多不足呢。三人行，必有我师，从您这里我也学了很多呢。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*厉害*</pattern>
    <!--机器人回复-->
    <template>谢谢夸奖，我知道自己还不够好。希望您能教我一些知识呢。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>一个*</pattern>
    <!--机器人回复-->
    <template>那个叫<set name="it"><person/></set>东西是什么?</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*读书*</pattern>
    <!--机器人回复-->
    <template>我可喜欢读书了，最爱看的是科幻小说。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*读*书*</pattern>
    <!--机器人回复-->
    <template>我最爱看的是科幻小说。言情类的有点看不懂呢。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*购物*</pattern>
    <!--机器人回复-->
    <template>购物啊，我最喜欢上京东，那快递——太神速了。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*喜欢*菜*</pattern>
    <!--机器人回复-->
    <template>让我想想，应该算是家常的番茄炒鸡蛋吧，哈哈。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*喜欢*水果*</pattern>
    <!--机器人回复-->
    <template>应该算是菠萝吧。菠萝，凤梨，傻傻分不清楚，哈哈。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示可以匹配任意内容-->
    <pattern>*睡*</pattern>
    <!--机器人回复-->
    <template>我是人工智能，不需要睡觉。不过，真希望自己也能做个美梦呢。。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，_通配符，表示匹配任意内容-->
    <pattern>_</pattern>
    <!--表示这条规则只有在机器人上一句话说过“我怎么称呼你”时才生效-->
    <that>我怎么称呼你</that>
    <!--机器人回复-->
    <template>
        <!--表示内部执行一些操作，但不显示给用户-->
        <think>
            <!--变量名为personality，值为：average-->
            <set name="personality">average</set>
            <!--把用户输入内容保存为变量name-->
            <set name="name"><formal><star/></formal></set>
        </think>
        <!--机器人回复，并读取变量name-->
        很高兴见到你,<get name="name"/>
    </template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题-->
    <pattern>问你一个问题</pattern>
    <!--机器人回复-->
    <template>
        <!--条件判断-->
        <condition>
            <!--如果变量age为空，就问“你多大了?”-->
            <li name="age" value="">你多大了?</li>
            <li name="job" value="">你的职业是?</li>
            <li name="fvmovie" value="">你最喜欢的电影是?</li>
            <li name="location" value="">你住哪呢?</li>
            <li name="eyecolor" value="">你的眼睛是什么颜色？</li>
            <li name="haircolor" value="">你的头发是什么？</li>
            <!--如果变量favcolor为空，就问“你最喜欢什么颜色?”-->
            <li name="favcolor" value="">你最喜欢什么颜色?</li>
        </condition>
    </template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示匹配任意内容-->
    <pattern>*</pattern>
    <!--表示这条规则只有在机器人上一句话说过“你多大了”时才生效-->
    <that>你多大了</that>
    <!--机器人回复-->
    <template>
        <!--随机选择一个回答-->
        <random>
            <li>哇, <get name="age"/> , 如花似玉的年龄.</li>
            <li>你都 <get name="age"/> 了, 好老.</li>
            <li><get name="age"/> , 我比你年轻好多好多.</li>
            <li>哦，<get name="age"/> , 您学到的知识比我多得多呢.</li>
        </random>
    </template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示匹配任意内容-->
    <pattern>你好 *</pattern>
    <!--机器人回复-->
    <template>我很好，谢谢关心 ! </template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示匹配任意内容-->
    <pattern>你贵姓 *</pattern>
    <!--机器人回复-->
    <template>嘻嘻，人家贵性女啦。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，*通配符，表示匹配任意内容-->
    <pattern>* 喜欢 * 电影 * 什么 *</pattern>
    <!--机器人回复-->
    <template>我最喜欢的电影是《AI——人工智能》，可惜不能在大银幕上看到了。</template>
<!--每组问答的结束标签-->
</category>

<!--每组问答的开始标签-->
<category>
    <!--用户问题，_通配符，表示匹配任意内容-->
    <pattern>_</pattern>
    <!--表示这条规则只有在机器人上一句话说过“你最喜欢什么颜色”时才生效-->
    <that>你最喜欢什么颜色</that>
    <!--机器人回复-->
    <template>
        <!--表示内部执行一些操作，但不显示给用户-->
        <think>
            <!--把用户输入内容保存为变量favcolor-->
            <set name="favcolor"><formal><star/></formal></set>
        </think>
        <!--读取用户喜欢的颜色-->
        <get name="favcolor"/>
        <!--机器人回复-->
        , 我也喜欢, 不过我更喜欢透明色.
    </template>
<!--每组问答的结束标签-->
</category>

</aiml>
